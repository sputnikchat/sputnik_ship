# Copy this file to ".env" and fill in the values

# Port the server runs on
PORT=3000

# Secret used to sign session tokens (JWT). Change it to something long and random.
JWT_SECRET=change-this-to-a-long-random-secret

# How often shipments auto-update, in minutes (default 30)
TRACKING_REFRESH_MINUTES=30

# --- Tracking data mode ---
# "mock"  = uses simulated data (to test the app without courier accounts)
# "live"  = tries to use the couriers' real APIs (requires the keys below)
TRACKING_MODE=mock

# --- Real tracking (only needed if TRACKING_MODE=live) ---
# A single Ship24 API key (https://www.ship24.com/tracking-api) covers
# FedEx, UPS, DHL, USPS and 2500+ more couriers (auto-detects the
# carrier) - no need to create a separate developer account with each
# courier. Sign up there and paste the key they give you.
SHIP24_API_KEY=

# --- Email notifications (optional) ---
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Browser push notifications (optional) ---
# Generate these once with: npx web-push generate-vapid-keys
# If left empty, the app still works but without browser push
# (notifications remain available inside the app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
