# Copia este archivo a ".env" y completa los valores

# Puerto donde corre el servidor
PORT=3000

# Secreto para firmar los tokens de sesion (JWT). Cambialo por algo largo y random.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cada cuanto se actualizan los envios automaticamente, en minutos (default 30)
TRACKING_REFRESH_MINUTES=30

# --- Modo de datos de tracking ---
# "mock"  = usa datos simulados (para probar la app sin cuentas de courier)
# "live"  = intenta usar las APIs reales de los couriers (requiere las keys de abajo)
TRACKING_MODE=mock

# --- Tracking real (solo necesario si TRACKING_MODE=live) ---
# Una sola API key de Ship24 (https://www.ship24.com/tracking-api) cubre
# FedEx, UPS, DHL, USPS y +2500 couriers mas (detecta el carrier
# automaticamente) - no hace falta crear cuenta de developer en cada
# courier por separado. Registrate ahi y pegá la key que te dan.
SHIP24_API_KEY=

# --- Notificaciones por email (opcional) ---
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Notificaciones push del navegador (opcional) ---
# Generalas una sola vez con: npx web-push generate-vapid-keys
# Si las dejas vacias, la app funciona igual pero sin push del navegador
# (las notificaciones siguen quedando disponibles dentro de la app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
