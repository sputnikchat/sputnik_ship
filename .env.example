# Copy this file to ".env" and fill in the values

# Port the server runs on
PORT=3000

# --- Database (required) ---
# Postgres connection string. Create a free project at supabase.com, then
# copy this from Project Settings > Database > Connection string > URI.
# Local JSON-file storage doesn't survive a redeploy on most hosts, so this
# is required even for local dev now, not just production.
DATABASE_URL=

# Secret used to sign session tokens (JWT). Change it to something long and random.
JWT_SECRET=change-this-to-a-long-random-secret

# How often shipments auto-update, in minutes (default 30)
TRACKING_REFRESH_MINUTES=30

# Time of day (server's own timezone - set TZ below if needed) the daily
# "N arriving today, N delayed" digest notification goes out. 24h HH:MM.
DIGEST_TIME=08:00

# Optional: IANA timezone for TRACKING_REFRESH_MINUTES/DIGEST_TIME to run
# against (e.g. "Europe/Madrid"). Most hosts default to UTC otherwise.
TZ=

# --- Tracking data mode ---
# "mock"  = uses simulated data (to test the app without courier accounts)
# "live"  = tries to use the couriers' real APIs (requires the keys below)
TRACKING_MODE=mock

# --- Real tracking (only needed if TRACKING_MODE=live) ---
# Parcels (FedEx, UPS, DHL, USPS, Correos, SEUR, GLS... any courier) -
# one of these is enough:
# 17TRACK - api.17track.net -> Settings -> Security key (200 free numbers
# for new accounts, then paid). Sent as the "17token" header.
SEVENTEEN_TRACK_API_KEY=
# Ship24 - dashboard.ship24.com -> Integrations -> API Keys (apik_...),
# needs the Pro plan.
SHIP24_API_KEY=
# Air cargo (AWB) and ocean cargo (container / MBL): ShipsGo -
# shipsgo.com -> account -> API -> user token.
SHIPSGO_API_KEY=
# The courier blocks at the end of this file are optional backups.

# --- Email notifications (optional) ---
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Browser push notifications (optional) ---
# Generate these once with: npx web-push generate-vapid-keys
# If left empty, the app still works but without browser push
# (notifications remain available inside the app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# --- Encryption at rest (required) ---
# Encrypts each shipment's photo and declared value before they're saved,
# so a leaked DATABASE_URL or database backup doesn't hand over that data
# in plain text. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and back it up somewhere safe - losing it means losing
# access to every photo and declared value already saved with it.
ENCRYPTION_KEY=

# --- Audit log (required) ---
# Connection string for a restricted Postgres role that can only INSERT
# into the audit_log table (no SELECT/UPDATE/DELETE/TRUNCATE) - so the
# log is append-only by database permission, not just by convention.
# Generate it by running, once, with DATABASE_URL set to an admin-level
# role (Supabase's default "postgres" role qualifies):
#   node scripts/setup-audit-role.js
# That script creates the table and role and writes this value into your
# .env directly - it never prints the password to the terminal.
AUDIT_DATABASE_URL=

# --- DHL direct tracking (optional backup) ---
# Free key from developer.dhl.com -> My Apps -> app with "Shipment Tracking - Unified".
# When set, DHL shipments are tracked directly with DHL.
# Free tier: 250 calls/day, 1 every 5 s; request an upgrade in the portal for more.
DHL_API_KEY=

# --- USPS direct tracking (optional) ---
# USPS Business Account -> Customer Onboarding Portal -> My Apps -> Consumer Key / Secret.
# When both are set, USPS shipments are tracked directly with USPS.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# --- FedEx direct tracking (optional) ---
# developer.fedex.com -> My Projects -> project with the Track API -> API key / secret.
# Test keys work at once with FEDEX_SANDBOX=1; production keys need a FedEx account on the project.
# When both are set, FedEx shipments are tracked directly with FedEx.
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_SANDBOX=

# --- UPS direct tracking (optional) ---
# developer.ups.com -> My Apps -> app with the Tracking API -> Client ID / Client Secret.
# UPS_SANDBOX=1 uses the CIE test host. When both are set, UPS shipments are tracked with UPS.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_SANDBOX=
